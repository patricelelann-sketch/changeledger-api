# Copiez ce fichier en .env pour le développement local (.env n'est jamais commité).
# En production sur Railway, ces variables se configurent dans l'onglet "Variables" du service.

# Par défaut : base SQLite locale. Sur Railway, ajoutez un plugin Postgres :
# Railway injecte alors automatiquement DATABASE_URL avec les bonnes infos
# (vérifiez qu'elle pointe bien vers le service Postgres DU MÊME projet).
DATABASE_URL=sqlite:///./changeledger.db

# Clé API Anthropic, nécessaire pour classifier et résumer les changements détectés.
ANTHROPIC_API_KEY=

# Nom du modèle Claude à utiliser. Vérifiez le nom valide à jour dans la documentation :
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Authentification ---
# Secret de signature des tokens JWT. Générez une vraie valeur avec :
#   openssl rand -hex 32
# Ne JAMAIS utiliser la valeur par défaut du code en production.
JWT_SECRET_KEY=
# Durée de validité d'un token, en minutes (7 jours par défaut si non défini).
JWT_EXPIRE_MINUTES=10080

# --- Cron externe (ex. cron-job.org appelant /check-all) ---
# Secret partagé à fournir dans l'en-tête HTTP "X-Cron-Secret". Si vide,
# /check-all reste ouvert sans protection (pratique en dev local uniquement).
CRON_SECRET=

# --- Administration ---
# Secret partagé à fournir dans l'en-tête HTTP "X-Admin-Secret" pour les endpoints /admin/*
# (notamment l'activation manuelle du palier Entreprise). Contrairement à CRON_SECRET,
# ces endpoints refusent tout appel si cette valeur n'est pas définie (pas de mode ouvert).
# Générez une vraie valeur avec : openssl rand -hex 32
ADMIN_SECRET=

# --- Stripe ---
# Clé secrète du compte Stripe (mode test d'abord : sk_test_...).
STRIPE_SECRET_KEY=
# Secret de signature du webhook Stripe (fourni lors de la création du endpoint webhook).
STRIPE_WEBHOOK_SECRET=
# IDs des prix Stripe (Price ID, ex. price_xxx) pour chaque palier self-service.
# Le palier Entreprise n'a pas de prix Stripe : il s'active manuellement.
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
# URLs de redirection après paiement. Si elles ne commencent pas par "http",
# elles sont complétées automatiquement avec l'URL de l'API (pratique tant
# qu'il n'y a pas encore de frontend dédié).
CHECKOUT_SUCCESS_URL=/docs?checkout=success
CHECKOUT_CANCEL_URL=/docs?checkout=cancel
