# Copiez ce fichier en .env pour le développement local (.env n'est jamais commité).
# En production sur Railway, ces variables se configurent dans l'onglet "Variables" du service.

# Par défaut : base SQLite locale. Sur Railway, ajoutez un plugin Postgres :
# Railway injecte alors automatiquement DATABASE_URL avec les bonnes infos.
DATABASE_URL=sqlite:///./changeledger.db

# Clé API Anthropic, nécessaire pour classifier et résumer les changements détectés.
ANTHROPIC_API_KEY=

# Nom du modèle Claude à utiliser. Vérifiez le nom valide à jour dans la documentation :
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5
